<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>

        <!-- Kunci AI sungguhan dikosongkan paksa saat uji.

             Tiga uji di berkas ini menyatakan bahwa TANPA kunci tidak
             ada satu pun permintaan keluar. Tanpa baris di bawah, uji
             itu membaca kunci dari .env mesin yang menjalankannya:
             lulus di mesin yang belum memasang kunci, gagal di mesin
             yang sudah — dan yang gagal justru mesin pengembang yang
             memakai fiturnya setiap hari. Lebih buruk lagi, uji yang
             menyangka dirinya menguji keadaan "tanpa kunci" sebenarnya
             menembak titik akhir Gemini yang sesungguhnya, dengan kunci
             sungguhan, pada tiap kali dijalankan. -->
        <env name="GEMINI_API_KEY" value=""/>
        <env name="GEMINI_MODEL" value=""/>

        <!-- Turnstile dimatikan untuk seluruh suite, dengan alasan yang
             sama dan satu tambahan.

             Alasan yang sama: kuncinya dibaca dari .env mesin yang
             menjalankannya, sehingga suite-nya lulus di mesin yang belum
             memasang kunci dan gagal di mesin yang sudah.

             Tambahannya: yang gagal bukan uji Turnstile-nya, melainkan
             uji masuk, daftar, dan lupa sandi yang ditulis bertahun
             sebelum fitur ini ada dan tidak menyebutnya sama sekali.
             Pesannya pun tidak menyebut Turnstile — hanya "The user is
             not authenticated" pada uji masuk yang isinya benar. Sebabnya
             dicari di tempat yang sama sekali salah.

             Uji yang memang menguji fitur ini menyalakannya sendiri lewat
             config() di dalam ujinya, bukan dari sini. -->
        <env name="TURNSTILE_SITE_KEY" value=""/>
        <env name="TURNSTILE_SECRET_KEY" value=""/>
    </php>
</phpunit>
