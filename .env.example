APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Alamat mutlak dipakai untuk tautan pada surel dan alamat aset.
# Produksi: https://eqohsee.id
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Surel ────────────────────────────────────────────────────────────
# 'log' TIDAK mengirim apa pun; kodenya hanya ditulis ke
# storage/logs/laravel.log. Aman untuk mesin pengembangan, tetapi di
# server sungguhan ia membuat pendaftar terjebak selamanya di halaman
# verifikasi menunggu surel yang tidak pernah dikirim.
#
# Contoh Gmail (butuh Sandi Aplikasi, BUKAN kata sandi akun —
# https://myaccount.google.com/apppasswords, wajib verifikasi 2 langkah):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=tls
#   MAIL_USERNAME=akun@gmail.com
#   MAIL_PASSWORD="abcd efgh ijkl mnop"
#   MAIL_FROM_ADDRESS="akun@gmail.com"
#
# Alamat pengirim harus alamat yang benar-benar dimiliki: penyedia SMTP
# menolak mengirim atas nama domain yang bukan miliknya, dan surel yang
# lolos pun berakhir di folder spam.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@eqohsee.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Asisten AI halaman Bantuan (opsional) ────────────────────────────────
# Kunci dari Google AI Studio (aistudio.google.com) — Gemini punya kuota
# gratis. Tanpa kunci, asistennya mati dan seluruh pertanyaan diteruskan ke
# admin; tidak ada yang dijawab dengan tebakan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ── Pembelian: tujuan pembayaran ──
#
# QRIS_STATIS diisi kode QRIS STATIS milik merchant, disalin apa adanya
# dari bank atau penyedia pembayaran. Panjangnya 200-400 karakter dan
# diawali 00020101. Aplikasi menyisipkan nominal tagihan ke dalamnya
# sehingga pembeli tidak perlu mengetik angka.
#
# Kode ini TIDAK dapat dikarang: ia memuat NMID yang diterbitkan
# acquirer.
#
# Dibiarkan KOSONG, yang dipakai kode QRIS merchant EQOHSEE bawaan —
# lihat config/pembelian.php. Kode QRIS statis memang dirancang untuk
# dipajang: ia dicetak pada stiker dan ditempel di meja kasir, dan uang
# yang masuk lewatnya selalu menuju merchant yang sama. Isi baris ini
# hanya bila pembayarannya menuju merchant lain.
QRIS_STATIS=

BANK_NAMA="Bank Mandiri"
BANK_REKENING=
BANK_ATAS_NAMA=

# Berapa jam tagihan berlaku sebelum kedaluwarsa.
PEMBELIAN_KEDALUWARSA_JAM=48

# Cara menghubungi penjual, dipakai etalase publik untuk butir yang
# harganya belum diumumkan.
#
# Keduanya kosong, tombol "Minta penawaran" TIDAK digambar sama sekali —
# bukan digambar sebagai tautan mati. Nomor WhatsApp ditulis lengkap
# dengan kode negara, tanpa tanda plus: 6281234567890.
PEMBELIAN_WHATSAPP=
PEMBELIAN_EMAIL=
