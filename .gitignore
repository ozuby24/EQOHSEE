# ── EQOHSEE ──────────────────────────────────────────────
# Basis data lokal — berisi data asli, jangan pernah masuk repo
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal

# Cadangan yang dibuat installer paket
/storage/backup-*
/storage/app/tpkkp-lama-*.json
/storage/app/tpkkp-*-sebelum-*.json
/storage/app/public/*
!/storage/app/public/.gitkeep

# Berkas kerja Termux
*.zip
/.eqget-tmp

# Pengaturan pengiriman ke VPS — milik tiap mesin, bukan milik repo.
# Contohnya ada di deploy/vps.conf.example.
/deploy/vps.conf

# Salinan mentah unduhan deploy/ambil-video.sh — alat bantu
# penukaran, bukan aset situs. Lihat catatan di skrip itu.
/public/media/asal-drive/

# Salinan bertanggal hasil penyuntingan darurat.
#
# Dua belas berkas semacam ini pernah ikut ter-commit dan bertahan
# berbulan-bulan. Bahayanya bukan ukurannya melainkan kemiripannya:
# certificates/show.blade.php.bak-20260728 berisi templat sertifikat yang
# hampir sama dengan yang hidup, lengkap dengan tanda tangannya, dan yang
# membacanya tidak punya cara mengetahui mana yang benar-benar dipakai.
*.bak-*
*.bak
