<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS saja. Aplikasi ini membawa sesi masuk dan data pekerja; lalu
     lintas polos tidak diizinkan ke inang mana pun. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
