<?xml version="1.0" encoding="utf-8"?>
<!-- Layar pembuka sebelum Flutter menggambar (Android 11 ke bawah):
     latar ink dengan tanda EQOHSEE di tengah, sama dengan layar awal
     aplikasinya — tidak ada kilatan putih di antara keduanya. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/eq_ink" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_tanda" />
    </item>
</layer-list>
